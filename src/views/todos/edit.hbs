<section class="section">
  <h2 class="h2">редактировать</h2>
  <form action="/todos/{{todo.id}}/patch" method="POST" class="todo-form">
    <input type="text" name="text" value="{{todo.text}}" required class="todo-input">
    <label class="todo-checkbox">
      выполнено:
      <input type="checkbox" name="completed" {{#if todo.completed}}checked{{/if}}>
    </label>
    <button type="submit" class="btn">сохранить</button>
  </form>
</section>