<section class="section" id="catalog">
  <h2 class="h2">каталог</h2>
  <div class="category" id="bags">
    <h3 class="h3">сумки</h3>
    <div>
      {{#each bags}}
        <div class="product">
          <img src="{{this.imageUrl}}" alt="{{this.name}}" width="250" class="product-img">
          <p class="product-p">{{this.name}}</p>
        </div>
      {{/each}}
    </div>
  </div>
  <div class="category" id="shoes">
    <h3 class="h3">обувь</h3>
    <div>
      {{#each shoes}}
        <div class="product">
          <img src="{{this.imageUrl}}" alt="{{this.name}}" width="250" class="product-img">
          <p class="product-p">{{this.name}}</p>
        </div>
      {{/each}}
    </div>
  </div>
</section>

<section class="section" id="details">
    <h3 class="h3">детали продукции</h3>

    <div class="table-container">
      <div class="table-header">
        <div>модель</div>
        <div>сезон</div>
        <div>материал</div>
        <div>состояние</div>
      </div>

      <div class="table-row">
        <div>japanese draped mini</div>
        <div>SS 2022</div>
        <div>переработанная кожа</div>
        <div>9.5/10</div>
      </div>

      <div class="table-row">
        <div>japanese draped maxi</div>
        <div>SS 2022</div>
        <div>переработанная кожа</div>
        <div>9/10</div>
      </div>

      <div class="table-row">
        <div>gat grey sneakers</div>
        <div>AW 2006</div>
        <div>хлопок</div>
        <div>8/10</div>
      </div>

      <div class="table-row">
        <div>metallic ballerina tabi</div>
        <div>SS 2020</div>
        <div>металлизированная кожа</div>
        <div>10/10</div>
      </div>
    </div>
  </section>
</section>

<section class="section" id="about">
  <h2 class="h2">о нас</h2>
  <p class="p">
    архивный секонд, <em class="em">способный дать одежде новую жизнь</em>.
    здесь собраны уникальные модели прошлых лет, которые <del class="del">больше не выпускаются</del>, <ins class="ins">но сохраняют актуальность</ins>.
  </p>
</section>

<section class="section" id="history">
  <h2 class="h2">история бренда</h2>
  <div>
    <p class="p">
      мартин маржела - бельгийский дизайнер, чьё имя стало символом концептуальной и экспериментальной моды.
      с детства он переодевал куклы, шил одежду, мастерил обувь.
    </p>
    <p class="p">
      после окончания академии изящных искусств в антверпене он работал у жан-поля готье, где развил свои навыки,
      но вскоре начал собственный путь. бренд, основанный им, стремится не к знаменитости личности,
      а к тому, чтобы внимание было на самой одежде - на её идеях, материалах и ощущении.
    </p>
    <p class="p">
      маржела выворачивает одежду наизнанку, использует ткани, найденные на блошиных рынках, экспериментирует с формой,
      часто делает вещи нестандартными, даже утопичными эстетически. белый цвет, простая бирка без надписей и нумерация
      коллекций - всё это часть философии бренда: минимализм, антиреклама, отказ от украшательства ради личности.
    </p>
    <blockquote class="blockquote">
      <q>мода должна быть прогрессивной и бросать вызов нормам</q>
      <cite class="cite">&copy; martin margiela</cite>
    </blockquote>
  </div>
</section>